# aLogs: Aniiloger's Companion App — what never goes in the repository

# Sanctum Helper is its own project (github.com/sargeeva/SanctumHelper), checked out next to this one
/SanctumHelper/

# built output and downloads
node_modules/
target/
/builds/
/release/
/app/src-tauri/resources/
/app/src-tauri/build.json
/bossbar/build/
/bossbar/dist/
/bossbar/ocr-helper.exe
