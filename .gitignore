# aLogs: Aniiloger's Companion App — what never goes in the repository

# Sanctum Helper is its own project (github.com/sargeeva/SanctumHelper), checked out next to this one
/SanctumHelper/

# built output and downloads
node_modules/
target/
/builds/
/release/
__pycache__/
*.pyc

# the folders of the B16 app (the Python meter in bossbar/, the app shell in app/src-tauri/ and its UI in app/ui/),
# taken out of the repository on 17 Nov 2026: a checkout from before keeps its own leftovers in them (logs, settings,
# test pictures, the game's font and map art, build output), never committed. app/paths.mjs still reads the last RC
# number from app/src-tauri/target.
/bossbar/
/app/src-tauri/
/app/ui/

# your own data: logs, records, captures, settings and state (they live in %LOCALAPPDATA%\aLogs when installed)
/real-logs/
/notes/
*.local.json

# material from the game itself: extracted data (read from your own install)
/aniimo_data/

# helper scripts for one PC
/*.cmd

# log reports downloaded with tools/log-reports.mjs (players' logs: never committed)
/log-reports/

# the Rust rewrite (crates/, docs/rewrite-plan.md): its build output, the reference checkouts it is compared with,
# built programs and its local developer token
/target
/reference/
*.exe
dev-token
/tools/cv-goldens/bin/
/tools/cv-goldens/obj/
